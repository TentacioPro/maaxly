# Production environment variables
# These should be managed securely, e.g., via cloud secret manager or CI/CD variables
COMPOSE_PROJECT_NAME=maaxly
PORT=4000
HOST=0.0.0.0
MONGO_INITDB_ROOT_USERNAME=maaxly
MONGO_INITDB_ROOT_PASSWORD=maaxlypass
MONGODB_DB=maaxly_prod_db

# App user used by the backend to connect to MongoDB
MONGODB_APP_USER=maaxly_prod_user
MONGODB_APP_PASS=maaxlypass

# Backend connection string (auth via admin)
MONGODB_URI=mongodb://maaxly_prod_user:${MONGODB_APP_PASS}@mongodb:27017/maaxly_prod_db?authSource=admin

REDIS_URL=redis://redis:6379
KAFKA_BROKERS=kafka:29092
VITE_API_BASE=/api
TZ=Asia/Kolkata
# A strong, unique JWT secret is critical for security
JWT_SECRET=b245de8221a916fc8ff78d3ffa1f076ac55342008bda4ae3744b20522c7151bc14af768052b149f59a41bf111758c84e

# The backend API is proxied under the /api path by Nginx
# The frontend will make requests to /api, not a specific host/port
# VITE_API_BASE=/api

# #Production database credentials
## Use strong, unique passwords for production databases
# MONGO_INITDB_ROOT_USERNAME=maaxly_prod_user
# MONGO_INITDB_ROOT_PASSWORD=maaxlypass
# MONGODB_DB=maaxly_prod_db
#MONGODB_URI=mongodb://maaxly_prod_user:maaxlypass@mongodb:27017/maaxly_prod_db?authSource=admin
# DuckDNS for dynamic DNS updates in production
# Replace these values with your actual DuckDNS configuration
DUCKDNS_SUBDOMAINS=maaxly-prod-mvp
DUCKDNS_TOKEN=f344cb97-a09d-424f-b164-e2b151eb6681

# Nginx Proxy Manager ports
NPM_HTTP_PORT=8088
NPM_ADMIN_PORT=81
NPM_HTTPS_PORT=8443


# .env.prod
# COMPOSE_PROJECT_NAME=maaxly
# PORT=4000
# HOST=0.0.0.0
# MONGO_INITDB_ROOT_USERNAME=maaxly
# MONGO_INITDB_ROOT_PASSWORD=maaxlypass
# MONGODB_DB=maaxly_prod_db
# # prefer creating an app user (see README) and use it here
# MONGODB_URI=mongodb://app_user:strong_app_pass_here@mongodb:27017/maaxly_prod_db?authSource=maaxly_prod_db
# REDIS_URL=redis://redis:6379
# KAFKA_BROKERS=kafka:29092
# VITE_API_BASE=/api
# JWT_SECRET=replace_with_a_long_random_value
# DUCKDNS_SUBDOMAINS=your-subdomain
# DUCKDNS_TOKEN=replace_with_token
# TZ=Asia/Kolkata



# Usage examples:
# DEV: docker compose -f docker-compose.kafka.yml --profile dev --env-file .env.dev up -d
# PROD: docker compose -f docker-compose.kafka.yml --profile prod --env-file .env.prod up -d


# Notes:
# - Backend uses MONGODB_URI as single source of truth. Do not inject MONGODB_URI into the mongodb service.
# - Dockerfile.backend should install deps at build time and set CMD to start the server.
# - Dockerfile.frontend should build static assets and copy an nginx config that proxies /api to http://backend:4000
# - nginx-proxy-manager is optional; if you use it, configure its UI to point hostnames to frontend-prod and enable SSL via Let's Encrypt.