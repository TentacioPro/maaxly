# Production environment variables
# These should be managed securely, e.g., via cloud secret manager or CI/CD variables

# A strong, unique JWT secret is critical for security
JWT_SECRET=GENERATE_A_STRONG_RANDOM_SECRET_FOR_PRODUCTION

# The backend API is proxied under the /api path by Nginx
# The frontend will make requests to /api, not a specific host/port
VITE_API_BASE=/api

# Production database credentials
# Use strong, unique passwords for production databases
MONGO_INITDB_ROOT_USERNAME=maaxly_prod_user
MONGO_INITDB_ROOT_PASSWORD=REPLACE_WITH_A_STRONG_PASSWORD
MONGODB_DB=maaxly_prod_db

# DuckDNS for dynamic DNS updates in production (if needed)
# DUCKDNS_SUBDOMAINS=your-maaxly-instance
# DUCKDNS_TOKEN=your-duckdns-token

# Nginx Proxy Manager ports (optional, if using NPM)
# NPM_HTTP_PORT=80
# NPM_ADMIN_PORT=81
# NPM_HTTPS_PORT=443
