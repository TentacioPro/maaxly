# Production environment (copy to .env.prod and fill real values)

# Strong random secret (hex or base64). Do NOT commit real secret.
# Example (user-provided hex, replace if rotating):
# JWT_SECRET=b245de8221a916fc8ff78d3ffa1f076ac55342008bda4ae3744b20522c7151bc14af768052b149f59a41bf111758c84e
JWT_SECRET=b245de8221a916fc8ff78d3ffa1f076ac55342008bda4ae3744b20522c7151bc14af768052b149f59a41bf111758c84e

# Frontend origin and API base as served via Nginx Proxy Manager + DuckDNS
# If using a single domain with path-based routing, prefer:
#   CORS_ORIGIN=https://maaxly-prod-mvp.duckdns.org
#   VITE_API_BASE=/api
CORS_ORIGIN=https://maaxly-prod-mvp.duckdns.org
VITE_API_BASE=/api

# Mongo production creds
MONGO_INITDB_ROOT_USERNAME=maaxly
MONGO_INITDB_ROOT_PASSWORD=maaxlypass
MONGODB_DB=maaxly-prod

# DuckDNS for public domain and LE certs via NPM
DUCKDNS_SUBDOMAINS=maaxly-prod-mvp
DUCKDNS_TOKEN=f344cb97-a09d-424f-b164-e2b151eb6681

# Optional: override Nginx Proxy Manager host ports on Windows if 80/443 are occupied
# Access admin UI at http://localhost:8181 after applying these
NPM_HTTP_PORT=8080
NPM_HTTPS_PORT=8443
NPM_ADMIN_PORT=8181
